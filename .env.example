# Atelier local environment. Copy to .env.local and adjust; .env.local is
# gitignored. Everything here is a demo value; provider API keys are only ever
# read from the environment on the server and are never committed.

# PostgreSQL (docker compose up -d). Port 5433 on the host, 5432 in the container.
DATABASE_URL=postgres://atelier:atelier-dev@localhost:5433/atelier

# Session signing secret for the auth layer. Generate one for real use:
#   bun -e "console.log(crypto.randomUUID())"
BETTER_AUTH_SECRET=run-bun-e-console-log-crypto-randomUUID-or-openssl-rand-base64-32

# The single operator account seeded on first boot (demo credentials).
ATELIER_ADMIN_EMAIL=alex@atelier.local
ATELIER_ADMIN_PASSWORD=atelier-demo
ATELIER_ADMIN_NAME=Alex

# Provider API keys (all optional: with none set the app runs in demo mode
# against built-in mock providers, clearly labeled in the UI).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Canonical origin for auth callbacks in local development.
BETTER_AUTH_URL=http://localhost:3000
